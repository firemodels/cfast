&HEAD VERSION = 7600, TITLE = 'Per-fire water suppression in three rooms' /
!! Suppression with per-fire decay time constants.
!! Shared methane burners: 0.6 m by 0.6 m, 100 kW/m2, hence 36 kW.
!! Room A: decay times of 30, 15, 1000, and the default 432.8 s.
!! Room B: twice the spray density, a growing fire, and a delayed fire.
!! Room C: no active sprinkler; prescribed HRR must remain unchanged.
&TIME SIMULATION = 60, PRINT = 10, SMOKEVIEW = 10, SPREADSHEET = 0.02 /
&INIT INTERIOR_TEMPERATURE = 20, EXTERIOR_TEMPERATURE = 20 /
&MISC ADIABATIC = .TRUE., MAX_TIME_STEP = 0.1 /
&COMP ID = 'Room A', WIDTH = 10, DEPTH = 10, HEIGHT = 4, ORIGIN = 0,0,0 /
&COMP ID = 'Room B', WIDTH = 10, DEPTH = 10, HEIGHT = 4, ORIGIN = 12,0,0 /
&COMP ID = 'Room C', WIDTH = 10, DEPTH = 10, HEIGHT = 4, ORIGIN = 24,0,0 /
&VENT ID = 'Door A', TYPE = 'WALL', COMP_IDS = 'Room A','OUTSIDE', WIDTH = 2, BOTTOM = 0, TOP = 3 /
&VENT ID = 'Door B', TYPE = 'WALL', COMP_IDS = 'Room B','OUTSIDE', WIDTH = 2, BOTTOM = 0, TOP = 3 /
&VENT ID = 'Door C', TYPE = 'WALL', COMP_IDS = 'Room C','OUTSIDE', WIDTH = 2, BOTTOM = 0, TOP = 3 /
&FIRE ID = 'Reference', COMP_ID = 'Room A', FIRE_ID = 'Burner', LOCATION = 2,2, DECAY_TIME = 30 /
&FIRE ID = 'Stronger', COMP_ID = 'Room A', FIRE_ID = 'Burner', LOCATION = 7,2, DECAY_TIME = 15 /
&FIRE ID = 'No attenuation', COMP_ID = 'Room A', FIRE_ID = 'Burner', LOCATION = 2,7, DECAY_TIME = 1000 /
&FIRE ID = 'Legacy', COMP_ID = 'Room A', FIRE_ID = 'Burner', LOCATION = 7,7 /
&FIRE ID = 'Second room', COMP_ID = 'Room B', FIRE_ID = 'Burner', LOCATION = 2,2, DECAY_TIME = 30 /
&FIRE ID = 'Growing', COMP_ID = 'Room B', FIRE_ID = 'Growing burner', LOCATION = 7,2, DECAY_TIME = 60 /
&FIRE ID = 'Delayed', COMP_ID = 'Room B', FIRE_ID = 'Burner', LOCATION = 2,7, SETPOINT = 15, DECAY_TIME = 300 /
&FIRE ID = 'Dry room', COMP_ID = 'Room C', FIRE_ID = 'Burner', LOCATION = 2,2, DECAY_TIME = 30 /
&CHEM ID = 'Burner', CARBON = 1, HYDROGEN = 4, HEAT_OF_COMBUSTION = 50000, RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Burner', LABELS = 'TIME','HRR','HEIGHT','AREA','CO_YIELD','SOOT_YIELD','HCN_YIELD','TRACE_YIELD' /
&TABL ID = 'Burner', DATA = 0,36,0.25,0.36,0,0,0,0 /
&TABL ID = 'Burner', DATA = 60,36,0.25,0.36,0,0,0,0 /
&CHEM ID = 'Growing burner', CARBON = 1, HYDROGEN = 4, HEAT_OF_COMBUSTION = 50000, RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Growing burner', LABELS = 'TIME','HRR','HEIGHT','AREA','CO_YIELD','SOOT_YIELD','HCN_YIELD','TRACE_YIELD' /
&TABL ID = 'Growing burner', DATA = 0,18,0.25,0.36,0,0,0,0 /
&TABL ID = 'Growing burner', DATA = 60,54,0.25,0.36,0,0,0,0 /
&DEVC ID = 'Sprinkler A', TYPE = 'SPRINKLER', COMP_ID = 'Room A', LOCATION = 2,2,3.96,
      SETPOINT = 30, RTI = 20, SPRAY_DENSITY = 0.0001 /
&DEVC ID = 'Sprinkler B', TYPE = 'SPRINKLER', COMP_ID = 'Room B', LOCATION = 2,2,3.96,
      SETPOINT = 30, RTI = 10, SPRAY_DENSITY = 0.0002 /
&TAIL /
