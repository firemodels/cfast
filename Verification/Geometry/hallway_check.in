&HEAD VERSION = 7600, TITLE = 'CFAST Simulation' /
!! CFAST input generated by CEdit 8

&TIME SIMULATION = 2, PRINT = 1, SMOKEVIEW = 0.1, SPREADSHEET = 0.1 /
&INIT PRESSURE = 101325, RELATIVE_HUMIDITY = 50, INTERIOR_TEMPERATURE = 20, EXTERIOR_TEMPERATURE = 20,
      INTERIOR_O2_MASS_FRACTION = 0.23, EXTERIOR_O2_MASS_FRACTION = 0.23 /
&MISC ADIABATIC = .FALSE., LOWER_OXYGEN_LIMIT = 0.15, MAX_ITERATION = -1, OVERWRITE = .TRUE.,
      SPECIFIC_EXTINCTION = 8700, 4400 /

!! Compartments
&COMP ID = '1', DEPTH = 10, HEIGHT = 2.5, WIDTH = 4, ORIGIN = 0, 0, 0, GRID = 50, 50, 50,
      CEILING_MATL_ID = 'OFF', 'OFF', 'OFF', CEILING_THICKNESS = 0, 0, 0, WALL_MATL_ID = 'OFF', 'OFF', 'OFF',
      WALL_THICKNESS = 0, 0, 0, FLOOR_MATL_ID = 'OFF', 'OFF', 'OFF', FLOOR_THICKNESS = 0, 0, 0, HALL = .FALSE.,
      SHAFT = .FALSE., LEAK_AREA_RATIO = 0, 0, 0, FLOW_COEFFICIENT = 0 /
&COMP ID = '2', DEPTH = 10, HEIGHT = 2.5, WIDTH = 4, ORIGIN = 4, 0, 0, GRID = 50, 50, 50,
      CEILING_MATL_ID = 'OFF', 'OFF', 'OFF', CEILING_THICKNESS = 0, 0, 0, WALL_MATL_ID = 'OFF', 'OFF', 'OFF',
      WALL_THICKNESS = 0, 0, 0, FLOOR_MATL_ID = 'OFF', 'OFF', 'OFF', FLOOR_THICKNESS = 0, 0, 0, HALL = .TRUE.,
      SHAFT = .FALSE., LEAK_AREA_RATIO = 0, 0, 0, FLOW_COEFFICIENT = 0 /

!! Wall Vents
&VENT TYPE = 'WALL', ID = 'WallVent_1', COMP_IDS = '1' 'OUTSIDE', BOTTOM = 0, HEIGHT = 2.5, WIDTH = 10, FACE = 'LEFT',
      OFFSET = 0 /
&VENT TYPE = 'WALL', ID = 'WallVent_2', COMP_IDS = '2' 'OUTSIDE', BOTTOM = 0, HEIGHT = 2.5, WIDTH = 10, FACE = 'RIGHT',
      OFFSET = 0 /

!! Detection / Suppression
&DEVC TYPE = 'HEAT_DETECTOR', ID = 'H1A', COMP_ID = '1', LOCATION = 1, 1, 2.5, SETPOINT = 57, RTI = 50 /
&DEVC TYPE = 'HEAT_DETECTOR', ID = 'H1B', COMP_ID = '2', LOCATION = 1, 1, 2.5, SETPOINT = 57, RTI = 50 /
&DEVC TYPE = 'HEAT_DETECTOR', ID = 'H3A', COMP_ID = '1', LOCATION = 1, 3, 2.5, SETPOINT = 57, RTI = 50 /
&DEVC TYPE = 'HEAT_DETECTOR', ID = 'H3B', COMP_ID = '2', LOCATION = 1, 3, 2.5, SETPOINT = 57, RTI = 50 /
&DEVC TYPE = 'HEAT_DETECTOR', ID = 'H9A', COMP_ID = '1', LOCATION = 1, 9, 2.5, SETPOINT = 57, RTI = 50 /
&DEVC TYPE = 'HEAT_DETECTOR', ID = 'H9B', COMP_ID = '2', LOCATION = 1, 9, 2.5, SETPOINT = 57, RTI = 50 /

!! Fires
&FIRE ID = 'Fire_1', COMP_ID = '1', DECAY_TIME = 432.8, FIRE_ID = 'Fire_1_Def', IGNITION_CRITERION = 'TIME',
      SETPOINT = 0, LOCATION = 1, 1, SPRAY_DENSITY = 6.316e-05 /
&FIRE ID = 'Fire_2', COMP_ID = '2', DECAY_TIME = 432.8, FIRE_ID = 'Fire_1_Def', IGNITION_CRITERION = 'TIME',
      SETPOINT = 0, LOCATION = 1, 1, SPRAY_DENSITY = 6.316e-05 /

!! Fire Properties
&CHEM ID = 'Fire_1_Def', CARBON = 1, CHLORINE = 0, HYDROGEN = 4, NITROGEN = 0, OXYGEN = 0, HEAT_OF_COMBUSTION = 50000,
      RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Fire_1_Def', LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA', 'CO_YIELD',
      'SOOT_YIELD', 'HCN_YIELD', 'TRACE_YIELD' /
&TABL ID = 'Fire_1_Def', DATA = 0, 500, 0, 1, 0, 0.01, 0, 0 /
&TABL ID = 'Fire_1_Def', DATA = 100, 500, 0, 1, 0, 0.01, 0, 0 /

&TAIL /
