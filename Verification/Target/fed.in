&HEAD VERSION = 7600, TITLE = 'CFAST Simulation' /
!! CFAST input generated by CEdit 8

&TIME SIMULATION = 60, PRINT = 20, SMOKEVIEW = 1, SPREADSHEET = 1 /
&INIT PRESSURE = 101325, RELATIVE_HUMIDITY = 50, INTERIOR_TEMPERATURE = 20, EXTERIOR_TEMPERATURE = 20,
      INTERIOR_O2_MASS_FRACTION = 0.23, EXTERIOR_O2_MASS_FRACTION = 0.23 /
&MISC ADIABATIC = .FALSE., LOWER_OXYGEN_LIMIT = 0.15, MAX_ITERATION = -1, OVERWRITE = .TRUE.,
      SPECIFIC_EXTINCTION = 8700, 4400 /

!! Thermal Properties
&MATL ID = 'NM 1', MATERIAL = 'New Material 1', CONDUCTIVITY = 0.16, SPECIFIC_HEAT = 900, DENSITY = 790,
      THICKNESS = 0.016, EMISSIVITY = 0.9 /

!! Compartments
&COMP ID = 'Comp 1', DEPTH = 6, HEIGHT = 3, WIDTH = 6, ORIGIN = 0, 0, 0, GRID = 50, 50, 50,
      CEILING_MATL_ID = 'OFF', 'OFF', 'OFF', CEILING_THICKNESS = 0, 0, 0, WALL_MATL_ID = 'OFF', 'OFF', 'OFF',
      WALL_THICKNESS = 0, 0, 0, FLOOR_MATL_ID = 'OFF', 'OFF', 'OFF', FLOOR_THICKNESS = 0, 0, 0, HALL = .FALSE.,
      SHAFT = .FALSE., LEAK_AREA_RATIO = 0, 0, 0, FLOW_COEFFICIENT = 0 /

!! Wall Vents
&VENT TYPE = 'WALL', ID = 'WallVent_1', COMP_IDS = 'Comp 1' 'OUTSIDE', BOTTOM = 0.5, HEIGHT = 2, WIDTH = 1,
      FACE = 'FRONT', OFFSET = 1.5 /

!! Targets
&DEVC TYPE = 'PLATE', ID = 'Targ 1', COMP_ID = 'Comp 1', LOCATION = 0, 3, 2.5, SURFACE_ORIENTATION = 'Fire_1',
      MATL_ID = 'NM 1', THICKNESS = 0, TEMPERATURE_DEPTH = 0.5, DEPTH_UNITS = 'FRACTION' /
&DEVC TYPE = 'PLATE', ID = 'Targ 2', COMP_ID = 'Comp 1', LOCATION = 2.5, 3, 2.5, SURFACE_ORIENTATION = 'Fire_1',
      MATL_ID = 'NM 1', THICKNESS = 0, TEMPERATURE_DEPTH = 0.5, DEPTH_UNITS = 'FRACTION' /

!! Fires
&FIRE ID = 'Fire_1', COMP_ID = 'Comp 1', DECAY_TIME = 432.8, FIRE_ID = 'Fire_1_Def', IGNITION_CRITERION = 'TIME',
      SETPOINT = 0, LOCATION = 3, 3, SPRAY_DENSITY = 6.316e-05 /

!! Fire Properties
&CHEM ID = 'Fire_1_Def', CARBON = 2, CHLORINE = 0, HYDROGEN = 4, NITROGEN = 1, OXYGEN = 0, HEAT_OF_COMBUSTION = 30000,
      RADIATIVE_FRACTION = 0.35 /
&TABL ID = 'Fire_1_Def', LABELS = 'TIME', 'HRR', 'HEIGHT', 'AREA', 'CO_YIELD',
      'SOOT_YIELD', 'HCN_YIELD', 'TRACE_YIELD' /
&TABL ID = 'Fire_1_Def', DATA = 0, 175, 0, 0.1, 0.05, 0.01, 0.05, 0 /
&TABL ID = 'Fire_1_Def', DATA = 300, 175, 0, 0.1, 0.05, 0.01, 0.05, 0 /
